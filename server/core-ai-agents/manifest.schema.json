{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seo_ops.core_ai_agent_manifest.v1",
  "title": "SEO Ops Core AI Agent desired-state manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "name",
    "description",
    "system_prompt",
    "model",
    "thinking_effort",
    "max_turns",
    "timeout_seconds",
    "enable_memory",
    "type",
    "tools",
    "skill_ids",
    "subagent_ids",
    "dataset_config",
    "sandbox_config",
    "response_schema"
  ],
  "properties": {
    "manifest_version": {
      "const": "seo_ops.core_ai_agent_manifest.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\[SEO Ops\\] .+ v[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "thinking_effort": {
      "const": null
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600
    },
    "enable_memory": {
      "const": false
    },
    "type": {
      "const": "AGENT"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": ["BUILTIN", "MCP"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "skill_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subagent_ids": {
      "type": "array",
      "maxItems": 0
    },
    "dataset_config": {
      "type": "array",
      "maxItems": 0
    },
    "sandbox_config": {
      "type": "null"
    },
    "response_schema": {
      "type": "string",
      "minLength": 2
    }
  }
}
