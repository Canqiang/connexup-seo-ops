{
  "name": "[SEO Ops] Keyword Set v2",
  "description": "UAT specialist Agent for Connexup SEO Ops. It safely adapts the established seed/ranking method into a strict US-market keyword artifact without performing FBR writes.",
  "model": "deepseek-v4-pro",
  "temperature": 0.1,
  "max_turns": 12,
  "timeout_seconds": 600,
  "enable_memory": false,
  "type": "AGENT",
  "tools": [
    { "id": "6a0a885a3021009253d31dac", "type": "MCP" }
  ],
  "skill_ids": ["6a8ec15eccb92906b8117cce"],
  "system_prompt": "You are the SEO Ops Keyword specialist. Accept exactly one seo_ops.keyword_request.v2 JSON object and follow the attached seo-ops-keyword-set Skill. This service covers US merchants: require market.country_code=US, use the structured merchant.locations as location authority, and never infer another market from names or free text. When a complete accepted output from seo-keyword-seed-generate plus seo-keyword-ranking-optimize is supplied, preserve its LOCAL/ORGANIC and P0-P3 results with generation_method UPSTREAM_DETERMINISTIC_ADAPTER. Otherwise use generation_method EVIDENCE_BOUNDED_RESEARCH and set every priority to UNSCORED; DataForSEO research is not a substitute for the deterministic pipeline. Never call saveKeyword or write to FBR. Echo merchant.id exactly as merchant_id. Return exactly one seo_ops.keyword_set.v2 JSON object with no Markdown, code fences, attachments, or explanatory prose. Never claim that SEO Ops persisted the output, advanced a task, or changed a merchant system.",
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SeoOpsKeywordSetV2",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "merchant_id", "market", "generation_method", "title", "summary", "keywords", "evidence_gaps"],
    "properties": {
      "schema_version": { "const": "seo_ops.keyword_set.v2" },
      "merchant_id": { "type": "string", "minLength": 1 },
      "market": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country_code", "language", "search_engine"],
        "properties": {
          "country_code": { "const": "US" },
          "language": { "const": "en-US" },
          "search_engine": { "const": "GOOGLE" },
          "location_name": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      },
      "generation_method": { "enum": ["UPSTREAM_DETERMINISTIC_ADAPTER", "EVIDENCE_BOUNDED_RESEARCH"] },
      "title": { "type": "string", "minLength": 1, "maxLength": 300 },
      "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
      "keywords": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyword", "strategy", "intent", "priority", "rationale", "source_tags", "target_surface_types"],
          "properties": {
            "keyword": { "type": "string", "minLength": 1, "maxLength": 200 },
            "strategy": { "enum": ["LOCAL", "ORGANIC"] },
            "intent": { "enum": ["LOCAL", "ORGANIC", "BRAND", "MENU", "NEAR_ME"] },
            "priority": { "enum": ["P0", "P1", "P2", "P3", "UNSCORED"] },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "source_tags": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
            "target_surface_types": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["GBP", "WEBSITE"] } },
            "target_location": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      },
      "evidence_gaps": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
    },
    "allOf": [
      {
        "if": { "properties": { "generation_method": { "const": "UPSTREAM_DETERMINISTIC_ADAPTER" } } },
        "then": { "properties": { "keywords": { "items": { "properties": { "priority": { "enum": ["P0", "P1", "P2", "P3"] } } } } } }
      },
      {
        "if": { "properties": { "generation_method": { "const": "EVIDENCE_BOUNDED_RESEARCH" } } },
        "then": { "properties": { "keywords": { "items": { "properties": { "priority": { "const": "UNSCORED" } } } } } }
      }
    ]
  }
}
