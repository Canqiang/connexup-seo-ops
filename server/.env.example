# PostgreSQL connection (see docker-compose.yml at repo root for local creds).
DATABASE_URL=postgres://seo_ops:seo_ops@localhost:5432/seo_ops_dev
# TEST_DATABASE_URL is optional — tests fall back to DATABASE_URL (then the
# default above) and run against schema-isolated temp schemas, so it only
# needs setting if your test PG target differs from your dev DATABASE_URL.

# core-ai (UAT) — server-to-server agent runs.
# The token is a core-ai user API key (Bearer coreai_...). NEVER commit the
# real value; copy this file to .env (gitignored) and fill it in locally.
CORE_AI_BASE_URL=https://core-ai-server.connexup-uat.net
CORE_AI_TOKEN=
AGENT_RUN_AGENT_ID=2e0ad682-1dd2-430e-ba62-cec4c0061208

# Optional tuning (defaults shown)
# AGENT_RUN_POLL_INTERVAL_MS=3000
# AGENT_RUN_HTTP_TIMEOUT_MS=15000
